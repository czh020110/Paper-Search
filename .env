# ============================================================
# 公共默认配置（提交到 Git，不含敏感信息）
# 敏感信息（API Key 等）请放在 .env.local 中，.env.local 优先级更高
# ============================================================

# -- LLM 提供商 --
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=qwen3.6-plus
LLM_FAST_MODEL=qwen3.6-flash
LLM_THINKING=none

# -- 学术搜索 API（可选，无 key 也可使用公共端点，但有速率限制）--
# 搜索源开关（默认全部开启，设为 false 关闭）
SEARCH_SOURCE_S2=true
SEARCH_SOURCE_OA=true
SEARCH_SOURCE_ARXIV=true
SEARCH_SOURCE_DBLP=true

# -- Embedding / Reranker 模型提供商 --
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_ENABLED=true
EMBEDDING_CONCURRENCY=10
EMBEDDING_RPS_LIMIT=15

RERANKER_PROVIDER=dashscope
RERANKER_MODEL=qwen3-rerank
RERANKER_ENABLED=true
RERANKER_TOP_K_FALLBACK=30
RERANKER_RELATIVE_THRESHOLD_FACTOR=0.7
RERANKER_QUERY_MODE=combined

# -- 粗筛 (Coarse) --
COARSE_POOL_SKIP_THRESHOLD=40
COARSE_EMBEDDING_MIN_SIMILARITY=0.35
COARSE_WEIGHT_BM25=0.35
COARSE_WEIGHT_EMBEDDING=0.35
COARSE_WEIGHT_STRUCTURE=0.30
COARSE_WEIGHT_BM25_FALLBACK=0.60
COARSE_WEIGHT_STRUCTURE_FALLBACK=0.40
COARSE_RELATIVE_THRESHOLD_FACTOR=0.3

# -- 精筛 (Judge) --
JUDGE_CONCURRENCY=100
JUDGE_WAVE_CAP=5000

# -- 运行时 --
CACHE_DIR=.cache
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
