# 示例 .env 文件，复制并重命名为 .env，然后在.env里面填入你的配置，不要直接在本文件里面写入配置
# LLM 提供商: openai | dashscope | siliconflow | zhipuai
LLM_PROVIDER=openai

# LLM API 配置
LLM_API_KEY=your-api-key-here
# OpenAI 兼容 API 端点（可选，切换 Provider 时自动填充）
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=qwen3.6-plus
LLM_FAST_MODEL=qwen3.6-flash

# LLM 思考程度: none(关闭,默认) / off(不传参) / minimal / low / medium / high / xhigh
# OpenAI 映射为 reasoning_effort，其余映射为 enable_thinking
LLM_THINKING=none

# 学术搜索 API（可选，无 key 也可使用公共端点，但会有速率限制）
SEMANTIC_SCHOLAR_API_KEY=
# openalex mailto 字段填入邮箱，目前不需要 API key，但建议填写礼貌邮箱，api调用优先级更高
OPENALEX_MAILTO=your-email@example.com

# Embedding / Reranker 模型提供商（dashscope | siliconflow）和 API key
EMBEDDING_PROVIDER="dashscope"  # dashscope | siliconflow
RERANKER_PROVIDER="dashscope"  # dashscope | siliconflow

EMBEDDING_API_KEY=your-dashscope-api-key-here
RERANKER_API_KEY=your-dashscope-api-key-here

EMBEDDING_MODEL=text-embedding-v4
RERANKER_MODEL=qwen3-rerank

# 运行时配置
CACHE_DIR=.cache
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# ======== 调优参数（均可在 Web 界面 ⚙ 中修改，保存到 .env） ========

# -- 粗筛 (Coarse) --
# 候选池 ≤N 篇时跳过粗筛
COARSE_POOL_SKIP_THRESHOLD=40
# Embedding 余弦相似度硬底线（低于此值的论文直接排除）
COARSE_EMBEDDING_MIN_SIMILARITY=0.35
# 三路权重（有 Embedding 时）
COARSE_WEIGHT_BM25=0.35
COARSE_WEIGHT_EMBEDDING=0.35
COARSE_WEIGHT_STRUCTURE=0.30
# 降级权重（无 Embedding 时）
COARSE_WEIGHT_BM25_FALLBACK=0.60
COARSE_WEIGHT_STRUCTURE_FALLBACK=0.40
# 综合分截断因子（mean × factor 为阈值）
COARSE_RELATIVE_THRESHOLD_FACTOR=0.3

# -- 重排序 (Reranker) --
RERANKER_TOP_K_FALLBACK=30
RERANKER_RELATIVE_THRESHOLD_FACTOR=0.7

# 查询模式: combined(子查询合并为一行，默认) / max_per_query(每条子查询分别rerank取最高分)
RERANKER_QUERY_MODE=combined

# -- Embedding --
# 是否启用 Embedding（设为 false 关闭）
EMBEDDING_ENABLED=true
# 并发 worker 数量
EMBEDDING_CONCURRENCY=10
# API 调用速率限制（每秒最大请求数）
EMBEDDING_RPS_LIMIT=15
RERANKER_ENABLED=true

# -- 精筛 (Judge) --
# LLM 并发调用数
JUDGE_CONCURRENCY=100
# 单次 wave 处理上限
JUDGE_WAVE_CAP=5000