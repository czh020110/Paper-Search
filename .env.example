# LLM API 配置
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=qwen3.6-plus-nothinking
LLM_FAST_MODEL=qwen3.6-flash-nothinking

# 学术搜索 API（可选，无 key 也可使用公共端点）
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Embedding / Reranker（第二步启用）
EMBEDDING_PROVIDER="dashscope"
RERANKER_PROVIDER="dashscope"

EMBEDDING_API_KEY=
RERANKER_API_KEY=

EMBEDDING_MODEL=text-embedding-v4
RERANKER_MODEL=qwen3-rerank

# 运行时配置
CACHE_DIR=.cache
OUTPUT_DIR=outputs
LOG_LEVEL=INFO