# LLM API 配置
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 学术搜索 API（可选，无 key 也可使用公共端点）
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

# Embedding / Reranker（第二步启用）
EMBEDDING_API_KEY=
RERANKER_API_KEY=

# 运行时配置
CACHE_DIR=.cache
OUTPUT_DIR=outputs
LOG_LEVEL=INFO