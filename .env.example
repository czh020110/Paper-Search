# 示例 .env 文件，复制并重命名为 .env，然后在.env里面填入你的配置，不要直接在本文件里面写入配置
# LLM API 配置
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=qwen3.6-plus-nothinking
LLM_FAST_MODEL=qwen3.6-flash-nothinking

# 学术搜索 API（可选，无 key 也可使用公共端点，但会有速率限制）
SEMANTIC_SCHOLAR_API_KEY=
# openalex mailto 字段填入邮箱，目前不需要 API key，但建议填写礼貌邮箱，api调用优先级更高
OPENALEX_MAILTO=your-email@example.com

# Embedding / Reranker 模型提供商（目前只支持dashscope）和 API key
EMBEDDING_PROVIDER="dashscope"
RERANKER_PROVIDER="dashscope"

EMBEDDING_API_KEY=your-dashscope-api-key-here
RERANKER_API_KEY=your-dashscope-api-key-here

EMBEDDING_MODEL=text-embedding-v4
RERANKER_MODEL=qwen3-rerank

# 运行时配置
CACHE_DIR=.cache
OUTPUT_DIR=outputs
LOG_LEVEL=INFO